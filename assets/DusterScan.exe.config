<?xml version="1.0" encoding="utf-8"?>
<!--
  Copied next to DusterScan.exe by build.ps1.
  When the app is downloaded (or copied from another PC), Windows marks every file
  extracted from the zip as "from the internet". .NET Framework then refuses to load
  pywebview's Python.Runtime.dll ("Failed to resolve Python.Runtime.Loader.Initialize").
  loadFromRemoteSources tells .NET to trust the app's own bundled assemblies.
  https://learn.microsoft.com/dotnet/framework/configure-apps/file-schema/runtime/loadfromremotesources-element
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
